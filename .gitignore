# Downloaded or locally built dependencies
vision/.venv/
controller/frontend/node_modules/
**/__pycache__/
**/.pytest_cache/
firmware/.pio/

# Generated local processes and tunnel files; account snapshots and small logs remain tracked
controller/.runtime/*.exe
controller/.runtime/*.pid
controller/.runtime/cloudflared-live.yml
controller/.runtime/users.json.previous
controller/.runtime/users.json.reservations.json.previous
controller/.runtime/users.json.sessions.json*

# Raw diagnostic sessions are archived before upload
controller/diagnostics/runs/
controller/diagnostics/restored/

# Video is local-only data
output/vision/recordings/
*.mp4
*.avi
*.mkv
*.mov
*.webm
