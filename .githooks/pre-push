#!/bin/sh
set -eu

if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
  python_cmd=python3
elif command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
  python_cmd=python
else
  echo "Documentation check requires Python." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
if ! command -v node >/dev/null 2>&1; then
  echo "Diagnostic archive check requires Node.js." >&2
  exit 1
fi
node scripts/diagnostics/compact-runtime-logs.mjs --check
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  node scripts/diagnostics/check-repository-content.mjs "$local_sha"
  "$python_cmd" scripts/docs/check_docs.py --mode push --base "$remote_sha" --head "$local_sha"
done
